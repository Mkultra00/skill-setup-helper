# Local preview only: the filesystem adapter refuses non-loopback hosts.
CLAIMANT_LOCAL_MODE=true
YOU_API_KEY=
DAYTONA_API_KEY=
CREWAI_SERVICE_URL=http://127.0.0.1:8001
# Generate a random 32-byte hex secret; use the same value in BFF and FILER.
CREWAI_HMAC_SECRET=
OTEL_SDK_DISABLED=true
CREWAI_TELEMETRY_ENABLED=false
# Optional executable override for the isolated Daytona runner
# CLAIMANT_PYTHON=/absolute/path/to/.venv/bin/python
# Future authenticated Supabase deployment; not used by the local adapter
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# One requires a user-connected mailbox; never paste a connection into browser storage.
ONE_SECRET=

# Single-owner local development only; production requires per-user OAuth ownership.
ONE_GMAIL_CONNECTION_KEY=
